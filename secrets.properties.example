# Copy this file to `secrets.properties` (which is gitignored) and fill in your own keys.

DEEPGRAM_API_KEY=

# Fish Audio TTS (default voice/model IDs are public; add your own API key to synthesize)
FISH_AUDIO_API_KEY=
FISH_AUDIO_BACKUP_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_ID=933563129e564b19a115bedd57b7406a

# Inception Labs (Mercury Decide + Mercury 3)
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_ROUTER_MODEL=mercury-decide
INCEPTION_CHAT_MODEL=mercury-3

# Optional Google Antigravity OAuth (can also sign in from app Settings)
ANTIGRAVITY_CLIENT_ID=
ANTIGRAVITY_CLIENT_SECRET=
ANTIGRAVITY_ACCOUNTS_B64=
